#!/bin/sh

export PATH=/bin:/usr/bin

echo "================================"
echo "        Orange OS 0.2.0"
echo "================================"
echo "Platform: xnu++"
echo "Userspace: Orange"
echo

mkdir -p /proc /sys /dev /run /tmp /var/log /var/lib/orange

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

if [ -x /bin/orange ]; then
    /bin/orange init
fi

echo
echo "Orange OS userspace initialized."
echo

exec /bin/sh
